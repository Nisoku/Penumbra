import { Theme } from "@penumbra-component/index.slint";
import { NoteCardVM, TagVM } from "data.slint";

export component NoteCard inherits Rectangle {
    in property <NoteCardVM> card;
    in property <float> zoom: 1;
    in property <bool> selected: false;
    in property <[TagVM]> tags;

    callback activated(int);
    callback note-selected(int);
    callback note-moved(int, length, length);
    callback note-released(int, length, length);
    callback note-pinned(int, length, length);
    callback note-unpinned(int);
    callback link-start(int);
    callback link-move(int, length, length);
    callback link-end(int, length, length);

    property <bool> dragging: false;
    property <bool> right-dragging: false;
    property <bool> linking: false;
    property <length> grab-offset-x: 0px;
    property <length> grab-offset-y: 0px;
    property <length> last-x: 0px;
    property <length> last-y: 0px;

    x: card.x;
    y: card.y;
    width: 180px;
    height: 120px;
    clip: true;
    border-radius: 14px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.hairline;
    animate border-width {
        duration: 120ms;
        easing: ease-out;
    }
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: root.selected ? 4px : 2px;
    drop-shadow-blur: root.selected ? 24px : 16px;
    drop-shadow-color: Theme.card-shadow;
    animate drop-shadow-offset-y {
        duration: 120ms;
        easing: ease-out;
    }
    animate drop-shadow-blur {
        duration: 120ms;
        easing: ease-out;
    }
    transform-scale-x: root.dragging || root.right-dragging ? 103% : 100%;
    transform-scale-y: root.dragging || root.right-dragging ? 103% : 100%;
    animate transform-scale-x {
        duration: 600ms;
        easing: cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    animate transform-scale-y {
        duration: 600ms;
        easing: cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    base := Rectangle {
        border-radius: 14px;
        background: Theme.ground-sunken;
    }

    glass := Rectangle {
        border-radius: 14px;
        background: Theme.card-glass;
        opacity: root.dragging || root.right-dragging ? 0.86 : 1.0;
        animate opacity {
            duration: 120ms;
            easing: ease-out;
        }
    }

    Rectangle {
        y: 0px;
        width: parent.width;
        height: 1px;
        background: Theme.card-highlight;
    }

    if root.selected: Rectangle {
        border-radius: 14px;
        background: Theme.accent-soft;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 6px;

        Text {
            text: root.card.title;
            // callout role: 13 medium, card title
            font-size: 13px;
            font-weight: 600;
            color: Theme.ink;
            overflow: elide;
        }

        // preview: three lines normally, trimmed to two when a tag row needs the
        // space
        if root.zoom >= 0.55: Text {
            text: root.card.preview;
            font-size: 12px;
            color: Theme.ink-secondary;
            wrap: TextWrap.word-wrap;
            overflow: elide;
            height: root.tags.length > 0 ? 30px : 52px;
        }

        Rectangle {
            vertical-stretch: 1;
        }

        Rectangle {
            height: root.tags.length > 0 ? 14px : 0px;
        }
    }

    for tag[ti] in root.tags: HorizontalLayout {
        x: 16px + ti * 50px;
        y: parent.height - 22px;
        width: 46px;
        height: 12px;
        spacing: 4px;
        visible: root.zoom >= 0.55;
        Rectangle {
            width: 6px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: Theme.phase-hue(tag.hue);
        }

        Text {
            text: tag.label;
            font-size: 10px;
            color: Theme.ink-tertiary;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    // fixed-star pin marker: a four-point star drawn from two crossed diamonds
    if root.card.pinned: Rectangle {
        x: parent.width - 20px;
        y: 8px;
        width: 12px;
        height: 12px;

        Path {
            width: 100%;
            height: 100%;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 12;
            viewbox-height: 12;
            fill: Theme.accent;
            // a star
            commands: "M 6 0 C 6.6 4 8 5.4 12 6 C 8 6.6 6.6 8 6 12 C 5.4 8 4 6.6 0 6 C 4 5.4 5.4 4 6 0 Z";
        }
    }

    ta := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.left) {
                    // Alt (Option) + left drag draws a manual link to another
                    // card; a plain left drag moves this one.
                    if (event.modifiers.alt) {
                        root.linking = true;
                        root.link-start(root.card.id);
                        root.link-move(root.card.id, root.card.x + ta.pressed-x / root.zoom, root.card.y + ta.pressed-y / root.zoom);
                    } else {
                        root.dragging = true;
                        root.grab-offset-x = ta.pressed-x;
                        root.grab-offset-y = ta.pressed-y;
                        root.last-x = root.card.x;
                        root.last-y = root.card.y;
                        root.note-selected(root.card.id);
                    }
                } else if (event.button == PointerEventButton.right) {
                    root.right-dragging = true;
                    root.grab-offset-x = ta.pressed-x;
                    root.grab-offset-y = ta.pressed-y;
                    root.last-x = root.card.x;
                    root.last-y = root.card.y;
                }
            } else if (event.kind == PointerEventKind.up) {
                if (root.linking) {
                    root.linking = false;
                    root.link-end(root.card.id, root.card.x + ta.mouse-x / root.zoom, root.card.y + ta.mouse-y / root.zoom);
                } else if (root.dragging) {
                    root.dragging = false;
                    root.note-released(root.card.id, root.last-x, root.last-y);
                } else if (root.right-dragging) {
                    root.right-dragging = false;
                    let moved-by = root.grab-offset-x - ta.mouse-x;
                    let moved-by-y = root.grab-offset-y - ta.mouse-y;
                    if (moved-by.abs() >= 4px || moved-by-y.abs() >= 4px) {
                        root.note-pinned(root.card.id, root.last-x, root.last-y);
                    } else {
                        root.note-unpinned(root.card.id);
                    }
                }
            }
        }

        moved => {
            if (root.linking) {
                root.link-move(root.card.id, root.card.x + ta.mouse-x / root.zoom, root.card.y + ta.mouse-y / root.zoom);
            } else if (root.dragging || root.right-dragging) {
                root.last-x = root.card.x + (ta.mouse-x - root.grab-offset-x) / root.zoom;
                root.last-y = root.card.y + (ta.mouse-y - root.grab-offset-y) / root.zoom;
                root.note-moved(root.card.id, root.last-x, root.last-y);
            }
        }

        double-clicked => { root.activated(root.card.id); }
    }
}
