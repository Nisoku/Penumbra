import { Theme, NoteCardVM } from "theme.slint";

export component NoteCard inherits Rectangle {
    in property <NoteCardVM> card;
    callback activated(int);

    x: card.x;
    y: card.y;
    width: 180px;
    height: 120px;
    border-radius: 6px;
    background: Theme.ground-sunken;
    border-width: 1px;
    border-color: Theme.hairline;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        Text {
            text: card.title;
            font-size: 14px;
            font-weight: 600;
            color: Theme.ink;
            overflow: elide;
        }

        Text {
            text: card.preview;
            font-size: 12px;
            color: Theme.ink-secondary;
            wrap: TextWrap.word-wrap;
            overflow: elide;
        }

        if card.tags != "": Text {
            text: card.tags;
            font-size: 10px;
            color: Theme.ink-tertiary;
            overflow: elide;
        }
    }

    TouchArea {
        clicked => { root.activated(root.card.id); }
    }
}
