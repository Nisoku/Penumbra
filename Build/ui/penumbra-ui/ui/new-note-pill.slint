import { Theme } from "theme.slint";

export component NewNotePill inherits Rectangle {
    in property <bool> enabled: false;
    callback clicked();

    width: 148px;
    height: 46px;
    border-radius: 23px;
    background: Theme.accent;
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: 3px;
    drop-shadow-blur: 18px;
    drop-shadow-color: Theme.card-shadow;
    opacity: root.enabled ? 1.0 : 0.4;
    animate opacity { duration: 150ms; easing: ease-out; }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.width / 2;
        background: hover-glow.has-hover ? #FFFFFF1F : transparent;
        animate background { duration: 120ms; easing: ease-out; }
    }

    Rectangle {
        x: 18px;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;

        Rectangle {
            x: 8px;
            y: 0px;
            width: 2px;
            height: 18px;
            border-radius: 1px;
            background: #FFFFFF;
        }

        Rectangle {
            x: 0px;
            y: 8px;
            width: 18px;
            height: 2px;
            border-radius: 1px;
            background: #FFFFFF;
        }
    }

    Text {
        x: 46px;
        y: 0px;
        width: parent.width - 56px;
        height: parent.height;
        vertical-alignment: center;
        text: "New note";
        font-size: 14px;
        font-weight: 600;
        color: #FFFFFF;
    }

    hover-glow := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}