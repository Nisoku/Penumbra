import { Theme } from "@penumbra-component/index.slint";

export component EditorPanel inherits Rectangle {
    background: transparent;
    visible: root.open;
    clip: true;

    in property <bool> open: false;
    in property <string> note-title: "";
    in property <image> surface;
    in property <string> editor-status: "";
    in property <length> caret-x: 0px;
    in property <length> caret-y: 0px;
    in property <length> caret-h: 29px;
    in property <bool> caret-on: false;
    callback close();
    callback title-changed(string);
    callback input-key(string, bool, bool, bool, bool);
    callback pointer-down(length, length, bool);
    callback pointer-drag(length, length);
    callback pointer-double-click(length, length);
    callback pointer-triple-click(length, length);
    callback pointer-scroll(length);
    callback toggle-bold();
    callback toggle-italic();
    callback copy-selection();
    callback cut-selection();
    callback paste-clipboard();
    callback select-all();
    callback undo();
    callback redo();
    callback focus-changed(bool);
    callback surface-resized(length, length);

    // did you know it's actually called chrome? lol Google Chrome is chrome
    property <length> chrome-height: 52px;
    property <length> footer-height: 48px;
    property <length> h-margin: 48px;
    property <length> v-margin: 24px;
    // Cap the column width so prose stays readable on very wide windows 
    // (you'll never guess how i discovered this)
    property <length> max-surface-width: 1100px;
    property <length> avail-width: root.width - 2 * root.h-margin;
    property <length> avail-height: root.height - root.chrome-height - root.footer-height - 2 * root.v-margin;
    property <length> surface-width: Math.max(1px, Math.min(root.avail-width, root.max-surface-width));
    property <length> surface-height: Math.max(1px, root.avail-height);
    property <length> editor-x: (root.width - root.surface-width) / 2;
    property <length> editor-y: root.chrome-height + Math.max(root.v-margin, (root.height - root.chrome-height - root.footer-height - root.surface-height) / 2);
    property <bool> pointer-down-active: false;
    property <bool> blink-phase: false;
    // Consecutive click bookkeeping for synthesizing triple-click, such silly
    property <int> click-count: 0;
    property <length> last-click-x: -1000px;
    property <length> last-click-y: -1000px;

    // Grab keyboard focus the moment the editor becomes visible so typing
    // works immediately hehe
    changed open => {
        if (root.open) {
            editor-focus.focus();
            // the panel may have resized while closed, so resync on open
            root.surface-resized(root.surface-width, root.surface-height);
        }
    }

    // Keep Rust's render resolution in sync with Slint.
    changed surface-width => { root.surface-resized(root.surface-width, root.surface-height); }
    changed surface-height => { root.surface-resized(root.surface-width, root.surface-height); }

    blink-timer := Timer {
        interval: 530ms;
        running: root.open && editor-focus.has-focus;
        triggered => { root.blink-phase = !root.blink-phase; }
    }

    // Resets the consecutive-click counter once the multi-click window lapses.
    click-reset-timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            root.click-count = 0;
            self.running = false;
        }
    }

    dim := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: Theme.scrim;
        opacity: root.open ? 1 : 0;
        animate opacity { duration: 180ms; easing: ease-out; }
    }

    editor-shell := Rectangle {
        x: root.editor-x - 28px;
        y: root.editor-y - 24px;
        width: root.surface-width + 56px;
        height: root.surface-height + 48px;
        border-radius: 22px;
        background: Theme.card-glass;
        border-width: 1px;
        border-color: Theme.hairline;
    }

    shell-highlight := Rectangle {
        x: editor-shell.x + 1px;
        y: editor-shell.y + 1px;
        width: editor-shell.width - 2px;
        height: 1px;
        border-radius: 1px;
        background: Theme.card-highlight;
    }

    editor-surface := Rectangle {
        x: root.editor-x;
        y: root.editor-y;
        width: root.surface-width;
        height: root.surface-height;
        border-radius: 14px;
        background: Theme.ground-sunken;
        border-width: editor-focus.has-focus ? 2px : 1px;
        border-color: editor-focus.has-focus ? Theme.accent : Theme.hairline;
        clip: true;
        animate border-color { duration: 140ms; easing: ease-out; }

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            border-radius: 14px;
            background: Theme.ground;
            opacity: 0.82;
        }

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 1px;
            background: Theme.card-highlight;
        }

        Image {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            source: root.surface;
            image-fit: contain;
            image-rendering: smooth;
        }

        // Blinking caret overlay
        caret := Rectangle {
            x: root.caret-x;
            y: root.caret-y;
            width: 2px;
            height: root.caret-h;
            background: Theme.accent;
            visible: root.caret-on && editor-focus.has-focus;
            opacity: root.blink-phase ? 0.0 : 1.0;
        }
    }

    editor-focus := FocusScope {
        x: root.editor-x;
        y: root.editor-y;
        width: root.surface-width;
        height: root.surface-height;

        changed has-focus => { root.focus-changed(self.has-focus); }

        // Slint maps Cmd to `control` and the physical Ctrl key to `meta` on
        // macOS... which is wrong.¸
        key-pressed(event) => {
            if (event.text == Key.Backspace) {
                root.input-key("Backspace", event.modifiers.shift, event.modifiers.control, event.modifiers.meta, event.modifiers.alt);
                accept;
            } else if (event.text == Key.Delete) {
                root.input-key("Delete", event.modifiers.shift, event.modifiers.control, event.modifiers.meta, event.modifiers.alt);
                accept;
            } else if (event.text == Key.Return) {
                root.input-key("Enter", event.modifiers.shift, false, false, false);
                accept;
            } else if (event.text == Key.Tab) {
                root.input-key("Tab", event.modifiers.shift, false, false, false);
                accept;
            } else if (event.text == Key.Backtab) {
                root.input-key("BackTab", true, false, false, false);
                accept;
            } else if (event.text == Key.LeftArrow) {
                root.input-key("Left", event.modifiers.shift, event.modifiers.control, event.modifiers.meta, event.modifiers.alt);
                accept;
            } else if (event.text == Key.RightArrow) {
                root.input-key("Right", event.modifiers.shift, event.modifiers.control, event.modifiers.meta, event.modifiers.alt);
                accept;
            } else if (event.text == Key.UpArrow) {
                root.input-key("Up", event.modifiers.shift, event.modifiers.control, event.modifiers.meta, event.modifiers.alt);
                accept;
            } else if (event.text == Key.DownArrow) {
                root.input-key("Down", event.modifiers.shift, event.modifiers.control, event.modifiers.meta, event.modifiers.alt);
                accept;
            } else if (event.text == Key.Home) {
                root.input-key("Home", event.modifiers.shift, event.modifiers.control, event.modifiers.meta, event.modifiers.alt);
                accept;
            } else if (event.text == Key.End) {
                root.input-key("End", event.modifiers.shift, event.modifiers.control, event.modifiers.meta, event.modifiers.alt);
                accept;
            } else if (event.text == Key.PageUp) {
                root.input-key("PageUp", event.modifiers.shift, false, false, false);
                accept;
            } else if (event.text == Key.PageDown) {
                root.input-key("PageDown", event.modifiers.shift, false, false, false);
                accept;
            } else if (event.text == Key.Escape) {
                root.close();
                accept;
            } else if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == "z") {
                    if (event.modifiers.shift) { root.redo(); } else { root.undo(); }
                } else if (event.text == "y" && event.modifiers.meta) {
                    root.redo();
                } else if (event.text == "b") {
                    root.toggle-bold();
                } else if (event.text == "i") {
                    root.toggle-italic();
                } else if (event.text == "c") {
                    root.copy-selection();
                } else if (event.text == "x") {
                    root.cut-selection();
                } else if (event.text == "v") {
                    root.paste-clipboard();
                } else if (event.text == "a") {
                    root.select-all();
                }
                accept;
            } else if (event.text != "") {
                root.input-key(event.text, event.modifiers.shift, event.modifiers.control, event.modifiers.meta, event.modifiers.alt);
                accept;
            } else {
                reject;
            }
        }
    }

    pointer-area := TouchArea {
        x: root.editor-x;
        y: root.editor-y;
        width: root.surface-width;
        height: root.surface-height;
        mouse-cursor: text;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.pointer-down-active = true;
                editor-focus.focus();

                if (Math.abs(self.mouse-x - root.last-click-x) < 4px
                    && Math.abs(self.mouse-y - root.last-click-y) < 4px
                    && root.click-count > 0) {
                    root.click-count += 1;
                } else {
                    root.click-count = 1;
                }
                root.last-click-x = self.mouse-x;
                root.last-click-y = self.mouse-y;
                click-reset-timer.running = false;
                click-reset-timer.running = true;

                if (root.click-count >= 3) {
                    root.pointer-triple-click(self.mouse-x, self.mouse-y);
                    root.click-count = 0;
                } else if (root.click-count == 2) {
                    root.pointer-double-click(self.mouse-x, self.mouse-y);
                } else {
                    // Shift+click extends the current selection to the click.
                    root.pointer-down(self.mouse-x, self.mouse-y, event.modifiers.shift);
                }
            } else if (event.kind == PointerEventKind.move && root.pointer-down-active) {
                editor-focus.focus();
                root.pointer-drag(self.mouse-x, self.mouse-y);
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.pointer-down-active = false;
            }
        }

        scroll-event(event) => {
            editor-focus.focus();
            root.pointer-scroll(event.delta-y);
            accept;
        }
    }

    title-bar := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.chrome-height;
        background: Theme.ground;

        TextInput {
            x: 32px;
            y: 8px;
            width: parent.width * 0.44;
            height: 36px;
            vertical-alignment: center;
            text: root.note-title;
            font-size: 20px;
            font-weight: 600;
            color: Theme.ink;
            single-line: true;
            edited => { root.title-changed(self.text); }

            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close();
                    return accept;
                }
                return reject;
            }
        }

        Text {
            x: parent.width * 0.52;
            y: 0px;
            width: parent.width * 0.48 - 32px;
            height: parent.height;
            horizontal-alignment: right;
            vertical-alignment: center;
            text: root.editor-status;
            font-size: 11px;
            color: Theme.ink-secondary;
            overflow: elide;
        }

        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Theme.hairline;
        }
    }

    footer := Rectangle {
        x: 0px;
        y: parent.height - root.footer-height;
        width: parent.width;
        height: root.footer-height;
        background: Theme.ground;

        Rectangle {
            width: parent.width;
            height: 1px;
            background: Theme.hairline;
        }

        Text {
            x: 32px;
            y: 0px;
            width: parent.width - 64px;
            height: parent.height;
            font-size: 11px;
            color: Theme.ink-tertiary;
            vertical-alignment: center;
            horizontal-alignment: center;
            text: "Cmd+B bold · Cmd+I italic · Cmd+C copy · Cmd+X cut · Cmd+V paste · Cmd+Z undo · Cmd+Shift+Z redo · Esc close";
        }
    }
}
