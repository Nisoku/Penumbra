import { Theme, PillButton, TopBar } from "@penumbra-component/index.slint";
import { NoteCardVM } from "data.slint";
import { MapCanvas } from "map-canvas.slint";
import { EditorPanel } from "editor-panel.slint";

export component AppWindow inherits Window {
    title: "Penumbra";
    preferred-width: 1100px;
    preferred-height: 700px;
    background: Theme.ground;

    in property <image> editor-surface;
    in property <length> editor-caret-x: 0px;
    in property <length> editor-caret-y: 0px;
    in property <length> editor-caret-h: 29px;
    in property <bool> editor-caret-on: false;
    callback new-note();
    in property <string> status: "opening universe";
    in property <bool> ready: false;
    in property <[NoteCardVM]> note-cards: [];
    in property <string> grid-path: "";
    in property <string> edge-path: "";
    in property <string> selected-edge-path: "";
    in property <string> pending-link-path: "";
    in-out property <length> camera-x: 0px;
    in-out property <length> camera-y: 0px;
    in-out property <float> zoom: 1;
    in-out property <int> selected-note: -1;
    in property <string> note-title: "";
    in property <string> editor-status: "";
    in-out property <bool> editor-open: false;
    callback close-editor();
    callback editor-input-key(string, bool, bool, bool, bool);
    callback editor-focus-changed(bool);
    callback editor-surface-resized(length, length);
    callback editor-pointer-down(length, length, bool);
    callback editor-pointer-drag(length, length);
    callback editor-pointer-double-click(length, length);
    callback editor-pointer-triple-click(length, length);
    callback editor-pointer-scroll(length);
    callback editor-toggle-bold();
    callback editor-toggle-italic();
    callback editor-copy-selection();
    callback editor-cut-selection();
    callback editor-paste-clipboard();
    callback editor-select-all();
    callback editor-undo();
    callback editor-redo();
    callback editor-title-changed(string);
    callback open-note(int);
    callback camera-changed(length, length, float);
    callback note-selected(int);
    callback note-moved(int, length, length);
    callback note-released(int, length, length);
    callback note-pinned(int, length, length);
    callback note-unpinned(int);
    callback link-start(int);
    callback link-move(int, length, length);
    callback link-end(int, length, length);

    TopBar {
        x: 0;
        y: 0;
        width: parent.width;
        title: "Penumbra";
        search-placeholder: "Quick finder";
        search-enabled: root.ready;
    }

    MapCanvas {
        x: 0;
        y: 52px;
        width: parent.width;
        height: parent.height - 52px;
        status: root.status;
        note-cards: root.note-cards;
        grid-path: root.grid-path;
        edge-path: root.edge-path;
        selected-edge-path: root.selected-edge-path;
        pending-link-path: root.pending-link-path;
        camera-x <=> root.camera-x;
        camera-y <=> root.camera-y;
        zoom <=> root.zoom;
        selected-note <=> root.selected-note;
        open-note(id) => { root.open-note(id); }
        camera-changed(cx, cy, z) => { root.camera-changed(cx, cy, z); }
        note-selected(id) => { root.note-selected(id); }
        note-moved(id, wx, wy) => { root.note-moved(id, wx, wy); }
        note-released(id, wx, wy) => { root.note-released(id, wx, wy); }
        note-pinned(id, wx, wy) => { root.note-pinned(id, wx, wy); }
        note-unpinned(id) => { root.note-unpinned(id); }
        link-start(id) => { root.link-start(id); }
        link-move(id, wx, wy) => { root.link-move(id, wx, wy); }
        link-end(id, wx, wy) => { root.link-end(id, wx, wy); }
    }

    EditorPanel {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        open: root.editor-open;
        note-title: root.note-title;
        surface: root.editor-surface;
        editor-status: root.editor-status;
        caret-x: root.editor-caret-x;
        caret-y: root.editor-caret-y;
        caret-h: root.editor-caret-h;
        caret-on: root.editor-caret-on;
        close => { root.close-editor(); }
        input-key(text, shift, control, meta, alt) => { root.editor-input-key(text, shift, control, meta, alt); }
        focus-changed(focused) => { root.editor-focus-changed(focused); }
        surface-resized(w, h) => { root.editor-surface-resized(w, h); }
        pointer-down(x, y, extend) => { root.editor-pointer-down(x, y, extend); }
        pointer-drag(x, y) => { root.editor-pointer-drag(x, y); }
        pointer-double-click(x, y) => { root.editor-pointer-double-click(x, y); }
        pointer-triple-click(x, y) => { root.editor-pointer-triple-click(x, y); }
        pointer-scroll(pixels) => { root.editor-pointer-scroll(pixels); }
        toggle-bold => { root.editor-toggle-bold(); }
        toggle-italic => { root.editor-toggle-italic(); }
        copy-selection => { root.editor-copy-selection(); }
        cut-selection => { root.editor-cut-selection(); }
        paste-clipboard => { root.editor-paste-clipboard(); }
        select-all => { root.editor-select-all(); }
        undo => { root.editor-undo(); }
        redo => { root.editor-redo(); }
        title-changed(text) => { root.editor-title-changed(text); }
    }

    PillButton {
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - 24px;
        enabled: root.ready && !root.editor-open;
        visible: root.ready && !root.editor-open;
        text: "New note";
        animate opacity { duration: 150ms; easing: ease-out; }
        clicked => { root.new-note(); }
    }

    FocusScope {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        enabled: root.editor-open;

        key-pressed(event) => {
            if (event.text == Key.Escape && root.editor-open) {
                root.close-editor();
                return accept;
            }
            return reject;
        }
    }
}
