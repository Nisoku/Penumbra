export global Theme {
    out property<color> ground: #F7F5F0;
    out property<color> ground-sunken: #EFECE5;
    out property<color> ground-raised: #F7F5F0E6;
    out property<color> ink: #1F1D1A;
    out property<color> ink-secondary: #6B675E;
    out property<color> ink-tertiary: #98938A;
    out property<color> hairline: #1F1D1A24;
    out property<color> accent: #3D56B0;
    out property<color> accent-soft: #3D56B01F;
    out property<color> on-accent: #FFFFFF;
    out property<color> accent-hover: #FFFFFF1F;
    out property<color> card-glass: #FFFFFFB8;
    out property<color> card-highlight: #FFFFFF14;
    out property<color> card-shadow: #1F1D1A1A;
    out property<color> edge: #1F1D1A38;
    out property<color> edge-selected: #3D56B073;
    out property<color> placeholder: #98938A;
    out property<color> wash: #3D56B014;
    out property<color> well: #EFECE5;
    out property<color> scrim: #1F1D1A59;

    out property<length> radius-small: 6px;
    out property<length> radius-medium: 8px;
    out property<length> radius-pill: 23px;
    out property<[color]> phase-hues: [
        #5B7DB1,
        #4E9A8E,
        #7FA65A,
        #C9A227,
        #C97B4A,
        #A66A9C,
        #8878B8,
    ];

    pure public function phase-hue(index: int) -> color {
        return root.phase-hues[Math.mod(index, 7)];
    }
}
