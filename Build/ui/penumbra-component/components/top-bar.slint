import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component TopBar inherits Rectangle {
    in property <string> title: "";
    in property <string> search-placeholder: "";
    in property <bool> search-enabled: true;
    in-out property <string> search-text: "";
    callback search-edited(string);
    callback search-accepted(string);

    height: 52px;
    background: Theme.ground-raised;

    Text {
        x: 20px;
        y: 0;
        height: parent.height;
        vertical-alignment: center;
        text: root.title;
        font-size: 15px;
        font-weight: 600;
        color: Theme.ink;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 10px;
        width: 340px;
        height: 32px;
        border-radius: Theme.radius-medium;
        background: Theme.ground-sunken;

        LineEdit {
            x: 4px;
            y: 2px;
            width: parent.width - 8px;
            height: parent.height - 4px;
            placeholder-text: root.search-placeholder;
            enabled: root.search-enabled;
            text <=> root.search-text;
            edited(s) => { root.search-edited(s); }
            accepted(s) => { root.search-accepted(s); }
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }
}